From: Emre Yavuzalp <emreyavuzalp@gmail.com>
Subject: econet-eth: make eth-mangle endian-aware (BE + LE)

nf_flow_table_offload lays out the eth-rewrite mangle.val as host u32s. On
little-endian the upstream mtk byte-copy reproduces the MAC directly; on
big-endian the two 2-byte halves (dst[4:6], src[0:2]) come out zero, so the
decode-by-mask path is needed there. The previous unconditional BE version
corrupted the L2 rewrite on the little-endian EN7528 (EX20v) -- offloaded flows
got a scrambled next-hop MAC and were dropped. Gate on CONFIG_CPU_BIG_ENDIAN.

--- a/econet_ppe_offload.c
+++ b/econet_ppe_offload.c
@@ -202,24 +202,48 @@
 	}
 }
 
+/*
+ * Apply one eth-header rewrite action into the 14-byte L2 scratch buffer.
+ *
+ * nf_flow_table_offload encodes the new MACs as fixed actions whose value/
+ * mask are host u32s laid out for a LITTLE-ENDIAN CPU. On LE the upstream mtk
+ * byte-copy reproduces that directly; on big-endian the two 2-byte halves
+ * (dst MAC[4:6] and src MAC[0:2]) come out zero, so there decode each action
+ * by its mask and place the correct native bytes explicitly.
+ */
 static void
 en75_flow_offload_mangle_eth(const struct flow_action_entry *act, void *eth)
 {
-	void *dest = eth + act->mangle.offset;
-	const void *src = &act->mangle.val;
-
-	pr_info_ratelimited("econet-eth: ETHMANGLE off=%u mask=%08x val=%08x\n",
-			    act->mangle.offset, act->mangle.mask, act->mangle.val);
-
-	if (act->mangle.offset > 8)
-		return;
-
-	if (act->mangle.mask == 0xffff) {
-		src += 2;
-		dest += 2;
-	}
-
-	memcpy(dest, src, act->mangle.mask ? 2 : 4);
+#ifdef CONFIG_CPU_BIG_ENDIAN
+	const u8 *vb = (const u8 *)&act->mangle.val;	/* native (BE) bytes */
+	u8 *e = (u8 *)eth;
+
+	switch (act->mangle.mask) {
+	case 0x00000000:		/* dst[0:4] (off 0) or src[2:6] (off 8) */
+		if (act->mangle.offset <= 8)
+			memcpy(e + act->mangle.offset, vb, 4);
+		break;
+	case 0xffff0000:		/* dst MAC[4:6] -> eth[4:6] */
+		memcpy(e + 4, vb + 2, 2);
+		break;
+	case 0x0000ffff:		/* src MAC[0:2] -> eth[6:8] */
+		memcpy(e + 6, vb, 2);
+		break;
+	}
+#else
+	void *dest = eth + act->mangle.offset;
+	const void *src = &act->mangle.val;
+
+	if (act->mangle.offset > 8)
+		return;
+
+	if (act->mangle.mask == 0xffff) {
+		src += 2;
+		dest += 2;
+	}
+
+	memcpy(dest, src, act->mangle.mask ? 2 : 4);
+#endif
 }
 
 static int
